# Database
DATABASE_URI=file:./database.db
POSTGRES_PRISMA_URL=

# Payload CMS
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=https://el-waheed-shoes.vercel.app

# CSRF
CSRF_SECRET=
CSRF_TOKEN_SECRET=

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=          # Sentry DSN (optional, get from sentry.io)
SENTRY_AUTH_TOKEN=               # Sentry auth token for source maps (optional)

# Resend (email notifications)
RESEND_API_KEY=                   # Resend API key for email notifications (optional)
ADMIN_EMAIL=admin@elwaheedshoes.com  # Admin email for notifications
